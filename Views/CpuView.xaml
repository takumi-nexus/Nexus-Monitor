<UserControl x:Class="Nexus.App.Views.CpuView" xmlns:views="clr-namespace:Nexus.App.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource CardStyle}" Background="{DynamicResource AccentSoftBrush}"
                    Margin="0,0,0,16" Visibility="{Binding HasAdminNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="Certaines mesures (températures, tension, puissance, fréquences par cœur) nécessitent les droits administrateur. Relancez l'application en administrateur pour y accéder."/>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Identité" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Identity}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Mesures en direct" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Measures}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                        <TextBlock Text="{Binding FrequencyNote}" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Détail par cœur" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Utilisation par thread" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding LogicalProcessors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryText}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Usage}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="16,0,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Température" Style="{StaticResource SecondaryText}"/>
                                <TextBlock Grid.Column="2" Text="Fréquence" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Cores}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryText}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Temperature}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Frequency}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <views:PeriodSelectorView DataContext="{Binding ChartSettings}" Margin="0,24,0,12"/>
            <views:LiveChartView DataContext="{Binding UsageChart}" Margin="0,0,0,16"/>
            <views:LiveChartView DataContext="{Binding TemperatureChart}" Margin="0,0,0,16"/>
            <views:LiveChartView DataContext="{Binding FrequencyChart}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>