<UserControl x:Class="Nexus.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mesure" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding MetricChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,8"
                                        Command="{Binding DataContext.SelectMetricCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Période" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,8,0,10"/>
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding RangeChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource PillButtonStyle}"
                                            Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button DataContext="{Binding CompareChoice}" Content="{Binding Label}"
                                Style="{StaticResource PillButtonStyle}" Margin="12,0,0,0"
                                Command="{Binding DataContext.ToggleCompareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Actualiser" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="130" Margin="0,0,8,0" Command="{Binding RefreshCommand}"/>
                        <Button Content="Exporter en CSV" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="150" Margin="0,0,8,0" Command="{Binding ExportCsvCommand}"
                                ToolTip="Exporte la période affichée (séparateur point-virgule, compatible Excel)."/>
                        <Button Content="Supprimer l'historique" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="170" Command="{Binding DeleteHistoryCommand}"
                                ToolTip="Supprime définitivement toutes les mesures enregistrées."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding ChartTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                               ToolTip="Calculé sur toutes les mesures enregistrées de la période, pas seulement sur les points tracés."/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibility}}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Période sélectionnée" Style="{StaticResource SecondaryText}" Margin="0,0,16,0"/>
                        <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0"/>
                        <TextBlock Text="Période précédente (décalée pour se superposer)" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <lvc:CartesianChart Height="320"
                                            Series="{Binding Series}"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            TooltipPosition="Hidden"
                                            EasingFunction="{x:Null}"/>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding StatsText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RetentionText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>