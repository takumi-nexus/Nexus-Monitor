<UserControl x:Class="Nexus.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Apparence" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Thème de l'interface" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                    <ItemsControl Style="{StaticResource ChoiceGroupStyle}" ItemsSource="{Binding ThemeChoices}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mesures en direct" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Intervalle de rafraîchissement" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                    <ItemsControl Style="{StaticResource ChoiceGroupStyle}" ItemsSource="{Binding RefreshChoices}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="Une valeur plus courte rend l'affichage plus réactif mais consomme davantage de ressources. 1 s est un bon compromis."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Historique" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Enregistrement des mesures" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                    <ItemsControl Style="{StaticResource ChoiceGroupStyle}" ItemsSource="{Binding RecordingEnabledChoices}"/>
                    <TextBlock Text="Intervalle d'enregistrement" Style="{StaticResource SecondaryText}" Margin="0,4,0,8"/>
                    <ItemsControl Style="{StaticResource ChoiceGroupStyle}" ItemsSource="{Binding RecordingIntervalChoices}"/>
                    <TextBlock Text="Durée de conservation" Style="{StaticResource SecondaryText}" Margin="0,4,0,8"/>
                    <ItemsControl Style="{StaticResource ChoiceGroupStyle}" ItemsSource="{Binding RetentionChoices}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                               Text="Les mesures plus anciennes que la durée choisie sont supprimées automatiquement. Un enregistrement toutes les 5 secondes pendant 30 jours représente environ 80 Mo."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Système" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="Démarrer avec Windows" Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
                    <ItemsControl Style="{StaticResource ChoiceGroupStyle}" ItemsSource="{Binding StartupChoices}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Au démarrage de Windows, Nexus se lance sans droits administrateur : les températures nécessitent de le relancer en administrateur."/>

                    <TextBlock Text="{Binding AdminStatusText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <Button Content="Relancer en administrateur" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left" MinWidth="220" Command="{Binding RestartAsAdministratorCommand}"
                            Visibility="{Binding CanRestartAsAdministrator, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Données" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Exporter toutes les données (CSV)" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="260" Margin="0,0,8,0" Command="{Binding ExportAllCommand}"/>
                        <Button Content="Ouvrir le dossier des données" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="230" Command="{Binding OpenDataFolderCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Ce dossier contient l'historique (history.db), les paramètres (settings.json) et le journal d'erreurs (logs\nexus.log)."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="À propos" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Fonctionne entièrement en local : aucune donnée n'est envoyée sur Internet. Nexus ne modifie jamais les fréquences ni les tensions, et ne lance aucun test de stress."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>