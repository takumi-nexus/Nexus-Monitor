<UserControl x:Class="Nexus.App.Views.GpuView" xmlns:views="clr-namespace:Nexus.App.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource CardStyle}" Background="{DynamicResource AccentSoftBrush}"
                    Margin="0,0,0,16" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Processeur graphique" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding General}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Mémoire vidéo (VRAM)" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Vram}" ItemTemplate="{StaticResource MetricRowTemplate}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <views:PeriodSelectorView DataContext="{Binding ChartSettings}" Margin="0,24,0,12"/>
            <views:LiveChartView DataContext="{Binding UsageChart}" Margin="0,0,0,16"/>
            <views:LiveChartView DataContext="{Binding TemperatureChart}" Margin="0,0,0,16"/>
            <views:LiveChartView DataContext="{Binding VramChart}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>