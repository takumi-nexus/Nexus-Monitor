<UserControl x:Class="Nexus.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nexus.App.Views">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}"/>
            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,4,0,24"/>

            <Border Style="{StaticResource CardStyle}" Background="{DynamicResource AccentSoftBrush}"
                    Margin="0,0,0,16" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Border>

            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Identité et capacité" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Identity}"
                                                      ItemTemplate="{StaticResource MetricRowTemplate}"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Performances en direct" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Live}"
                                                          ItemTemplate="{StaticResource MetricRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Santé (SMART)" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Health}"
                                                          ItemTemplate="{StaticResource MetricRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <views:PeriodSelectorView DataContext="{Binding ChartSettings}" Margin="0,0,0,12"/>
            <views:LiveChartView DataContext="{Binding ActivityChart}" Margin="0,0,0,16"/>
            <views:LiveChartView DataContext="{Binding ThroughputChart}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>