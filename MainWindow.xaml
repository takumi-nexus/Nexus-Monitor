<Window x:Class="Nexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NEXUS Hardware Monitor"
        Height="780"
        Width="1280"
        MinHeight="600"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="pack://application:,,,/Assets/logo-taskbar.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="6"
            CornerRadius="10"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#EEEEEE"
                BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0">

                    <Image Source="pack://application:,,,/Assets/logo-app.png"
                           Width="23"
                           Height="23"
                           Stretch="Uniform"/>

                    <TextBlock Text="NEXUS"
                               Margin="10,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#333333"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  /  Hardware Monitor"
                               FontSize="12"
                               Foreground="#999999"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- MINIMIZE -->
                <Button Grid.Column="1"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Minimize_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="—"
                               FontSize="14"
                               Foreground="#555555"/>
                </Button>

                <!-- MAXIMIZE -->
                <Button Grid.Column="2"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Maximize_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock x:Name="MaximizeIcon"
                               Text="□"
                               FontSize="15"
                               Foreground="#555555"/>
                </Button>

                <!-- CLOSE -->
                <Button Grid.Column="3"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Close_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <TextBlock Text="×"
                               FontSize="21"
                               Foreground="#555555"/>
                </Button>

            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Background="{DynamicResource SidebarBrush}"
                    Padding="16">

                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Margin="8,8,0,28">

                        <Image Source="pack://application:,,,/Assets/logo-app.png"
                               Width="120"
                               Height="120"
                               Stretch="Uniform"/>

                        <TextBlock Text="NEXUS"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>

                        <TextBlock Text="Hardware Monitor"
                                   Style="{StaticResource SecondaryText}"/>

                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButtonStyle}"
                                        Command="{Binding DataContext.NavigateCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Width="28"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"/>

        </Grid>
    </Grid>
</Window>
